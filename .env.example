# LLM provider API keys — copy to .env and fill in the ones you need

# OpenAI (GPT-4o, etc.)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# Kimi / Moonshot
MOONSHOT_API_KEY=

# Qwen / DashScope (Alibaba)
DASHSCOPE_API_KEY=

# Local LLM endpoint (ollama, vLLM, LM Studio, etc.)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
